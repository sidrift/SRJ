@page "/gold-rates"

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@inject HttpClient Http
@inject NavigationManager NavigationManager

@inherits srj.Blazor.Services.AuthorizedPageBase

<HeadContent>
	<link href="css/gold-rate.css" rel="stylesheet"/>
</HeadContent>


<PageTitle>Gold Rates</PageTitle>


@if (_showSuccess) {
	<div class="dialog-overlay">
		<div class="success-dialog">
			<i class="bi bi-check-circle-fill"></i>
			Gold price updated successfully.
		</div>
	</div>
}


<div class="@(_showSuccess ? "blur-background" : "")">

	<div class="gold-rate-container">

		<div class="gold-header">

			<div>
				<h2>
					<i class="bi bi-coin"></i>
					Gold Rates
				</h2>

			</div>

			<div class="gold-date">
				<i class="bi bi-calendar3"></i>
				@DateTime.Now.ToString("dd MMM yyyy")
			</div>

		</div>


		@if (_loading) {
			<div class="text-center">
				<div class="spinner-border text-warning"></div>
			</div>
		} else {
			@if (!string.IsNullOrEmpty(_error)) {
				<div class="alert alert-danger">
					@_error
				</div>
			}


			<EditForm EditContext="_editContext"
			          OnValidSubmit="SaveRate">


				<div class="rate-card">


					<div class="rate-section">

						<h5>
							<i class="bi bi-box-seam"></i>
							Gold Imported (24K)
						</h5>


						<div class="rate-grid">

							<div class="rate-field">
								<label>Sell Price</label>

								<div class="input-group">
									<span>₹</span>

									<InputNumber class="form-control"
									             @bind-Value="_goldRate.SellPrice24KImp"/>
								</div>
							</div>


							<div class="rate-field">
								<label>Buy Price</label>

								<div class="input-group">
									<span>₹</span>

									<InputNumber class="form-control"
									             @bind-Value="_goldRate.BuyPrice24KImp"/>
								</div>
							</div>

						</div>

					</div>


					<div class="rate-section">

						<h5>
							<i class="bi bi-gem"></i>
							Gold FT (24K)
						</h5>


						<div class="rate-grid">

							<div class="rate-field">
								<label>Sell Price</label>

								<div class="input-group">
									<span>₹</span>

									<InputNumber class="form-control"
									             @bind-Value="_goldRate.SellPrice24KFt"/>
								</div>
							</div>


							<div class="rate-field">
								<label>Buy Price</label>

								<div class="input-group">
									<span>₹</span>

									<InputNumber class="form-control"
									             @bind-Value="_goldRate.BuyPrice24KFt"/>
								</div>
							</div>

						</div>

					</div>


					<div class="text-end mt-4">

						<button class="save-btn"
						        type="submit"
						        disabled="@(!_canSave || _saving)">

							<i class="bi bi-floppy-fill me-2"></i>

							@(_saving ? "Saving..." : "Save Gold Rates")

						</button>

					</div>


				</div>


			</EditForm>
		}

	</div>

</div>



@code {
	private GoldRateRequest _goldRate = new();
	private GoldRateRequest _originalRate = new();

	private EditContext? _editContext;

	private bool _loading;
	private bool _saving;
	private bool _canSave;
	private bool _showSuccess;

	private string? _error;

	protected override async Task OnInitializedAsync() {
		_loading = true;


		try {
			var rate =
				await Http.GetFromJsonAsync<GoldRateResponse>(
					"gold-rate/today");


			if (rate != null) {
				_goldRate = new GoldRateRequest {
					SellPrice24KImp = rate.SellPrice24KImp,
					BuyPrice24KImp = rate.BuyPrice24KImp,
					SellPrice24KFt = rate.SellPrice24KFt,
					BuyPrice24KFt = rate.BuyPrice24KFt
				};


				_originalRate = Clone(_goldRate);
			}
		}
		catch {
			_goldRate = new GoldRateRequest();
			_originalRate = new GoldRateRequest();
		}


		_editContext = new EditContext(_goldRate);

		_editContext.OnFieldChanged += (_, _) => {
			_canSave = HasChanges();
			StateHasChanged();
		};


		_loading = false;
	}

	private async Task SaveRate() {
		_error = null;


		if (!IsValidRate()) {
			_error = "All gold prices must be greater than 0.";
			return;
		}


		_saving = true;


		var response =
			await Http.PutAsJsonAsync(
				"gold-rate",
				_goldRate);


		if (response.IsSuccessStatusCode) {
			_showSuccess = true;

			StateHasChanged();


			await Task.Delay(2000);


			NavigationManager.NavigateTo("/");
		} else {
			_error = "Failed to update gold rate.";
		}


		_saving = false;
	}

	private bool HasChanges() {
		return
			_goldRate.SellPrice24KImp != _originalRate.SellPrice24KImp ||
			_goldRate.BuyPrice24KImp != _originalRate.BuyPrice24KImp ||
			_goldRate.SellPrice24KFt != _originalRate.SellPrice24KFt ||
			_goldRate.BuyPrice24KFt != _originalRate.BuyPrice24KFt;
	}

	private bool IsValidRate() {
		return
			_goldRate.SellPrice24KImp > 0 &&
			_goldRate.BuyPrice24KImp > 0 &&
			_goldRate.SellPrice24KFt > 0 &&
			_goldRate.BuyPrice24KFt > 0;
	}

	private GoldRateRequest Clone(GoldRateRequest x) {
		return new GoldRateRequest {
			SellPrice24KImp = x.SellPrice24KImp,
			BuyPrice24KImp = x.BuyPrice24KImp,
			SellPrice24KFt = x.SellPrice24KFt,
			BuyPrice24KFt = x.BuyPrice24KFt
		};
	}

	public class GoldRateRequest {
		public decimal? SellPrice24KImp { get; set; }
		public decimal? BuyPrice24KImp { get; set; }
		public decimal? SellPrice24KFt { get; set; }
		public decimal? BuyPrice24KFt { get; set; }
	}

	public class GoldRateResponse {
		public DateOnly PriceDate { get; set; }

		public decimal? SellPrice24KImp { get; set; }
		public decimal? BuyPrice24KImp { get; set; }

		public decimal? SellPrice24KFt { get; set; }
		public decimal? BuyPrice24KFt { get; set; }

		public DateTime UpdatedAt { get; set; }
	}
}
@page "/item-categories"
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json

@inherits srj.Blazor.Services.AuthorizedPageBase

@inject HttpClient Http

<PageTitle>Item Categories</PageTitle>

<HeadContent>
	<link href="css/item-category.css" rel="stylesheet" />
</HeadContent>

<div class="item-category-container">

	@if (!string.IsNullOrWhiteSpace(_successMessage))
	{
		<div class="alert alert-success">
			<i class="bi bi-check-circle-fill"></i>
			@_successMessage
		</div>
	}

	@if (!string.IsNullOrWhiteSpace(_errorMessage))
	{
		<div class="alert alert-danger">
			<i class="bi bi-exclamation-triangle-fill"></i>
			@_errorMessage
		</div>
	}

	<!-- HEADER -->

	<div class="page-header">

		<h2>
			<i class="bi bi-tags-fill"></i>
			Item Categories
		</h2>

	</div>

	<!-- ADD CATEGORY -->

	<div class="category-card @(_model.Metal == 1 ? "gold-theme" : "silver-theme")">

		<h4>
			<i class="bi @(_model.Metal == 1
				             ? "bi-plus-circle-fill"
				             : "bi-plus-circle-fill")"></i>

			Add @(_model.Metal == 1 ? "Gold" : "Silver") Category
		</h4>

		<div class="metal-selection">

			<label class="section-label">
				Select Metal
			</label>

			<div class="metal-buttons">

				<button type="button"
					class="metal-btn gold @(_model.Metal == 1 ? "selected" : "")"
					@onclick="SelectGold">

					<i class="bi bi-coin"></i>
					Gold

				</button>

				<button type="button"
					class="metal-btn silver @(_model.Metal == 2 ? "selected" : "")"
					@onclick="SelectSilver">

					<i class="bi bi-circle-half"></i>
					Silver

				</button>

			</div>

		</div>

		<div class="form-check remember-choice mt-3">

			<input class="form-check-input"
				type="checkbox"
				id="rememberChoice"
				@bind="_rememberSelection" />

			<label class="form-check-label"
				for="rememberChoice">

				Remember selected metal for next category

			</label>

		</div>

		<div class="mt-4">

			<label class="form-label">
				Category Name
			</label>

			<div class="input-group category-name-input">

				<span class="input-group-text">

					@(_model.Metal == 1 ? "G -" : "S -")

				</span>

				<input class="form-control"
				       placeholder="Enter category name..."
				       value="@_model.Name"
				       @oninput="OnNameChanged" />

			</div>

		</div>

		<div class="mt-4">

			<button class="btn-save"
			        disabled="@(!_canSave || _saving)"
			        @onclick="SaveCategory">

				@if (_saving)
				{
					<span class="spinner-border spinner-border-sm me-2"></span>
				}
				else
				{
					<i class="bi bi-check-circle-fill me-2"></i>
				}

				Save Category

			</button>

		</div>

	</div>

	<!-- CATEGORY LIST -->

	<div class="category-card mt-4">

		<div class="category-header-row">

			<div class="category-title">

				<h4 class="mb-0">

					<i class="bi bi-list-ul"></i>

					Existing Categories

				</h4>

			</div>

			<div class="category-toolbar">

				@if (_loading)
				{
					<span class="spinner-border spinner-border-sm"></span>
				}

				<div class="category-search">

					<i class="bi bi-search"></i>

					<input class="form-control"
						placeholder="Search category..."
						value="@_search"
						autocomplete="off"
						@oninput="OnSearchChanged" />

				</div>

				<div class="filter-buttons">

					<button class="filter-btn @(_selectedMetal == null ? "active" : "")"
						@onclick="() => ChangeFilter(null)">

						<i class="bi bi-grid"></i>

						All

					</button>

					<button class="filter-btn gold @(_selectedMetal == 1 ? "active" : "")"
						@onclick="() => ChangeFilter(1)">

						<i class="bi bi-coin"></i>

						Gold

					</button>

					<button class="filter-btn silver @(_selectedMetal == 2 ? "active" : "")"
						@onclick="() => ChangeFilter(2)">

						<i class="bi bi-circle-half"></i>

						Silver

					</button>

				</div>

			</div>

		</div>

		@if (!_loading && !_categories.Any())
		{

			<div class="text-center text-muted py-5">

				<i class="bi bi-inbox fs-1"></i>

				<div>
					No categories found.
				</div>

			</div>

		}

		else
		{

			<table class="table category-table align-middle">

				<thead>

					<tr>

						<th>
							Metal
						</th>

						<th>
							Category
						</th>

						<th>
							Actions
						</th>

					</tr>

				</thead>

				<tbody>

					@foreach(var category in _categories)
					{

						<tr>

							<td>

								<span class="metal-badge @(category.Metal == 1 ? "gold" : "silver")">

									<i class="bi @(category.Metal == 1 ? "bi-coin" : "bi-circle-half")">

									</i>

								</span>

							</td>

							<td>

								@if (category.IsEditing)
								{
									<div class="input-group category-name-input">

										<span class="input-group-text">
											@(category.Metal == 1 ? "G -" : "S -")
										</span>

										<input class="form-control"
										       @bind="category.EditName" />

									</div>
								}
								else
								{
									<strong>@category.Name</strong>
								}

							</td>

							<td>

								@if(category.IsEditing)
								{

									<button class="btn-action btn-save-action"
										@onclick="() => Update(category)">

										<i class="bi bi-check-lg"></i>

									</button>

									<button class="btn-action btn-cancel"
										@onclick="() => CancelEdit(category)">

										<i class="bi bi-x-lg"></i>

									</button>

								}
								else
								{

									<button class="btn-action btn-edit"
										@onclick="() => Edit(category)">

										<i class="bi bi-pencil-fill"></i>

									</button>

									<button class="btn-action btn-delete"
										@onclick="() => Delete(category)">

										<i class="bi bi-trash-fill"></i>

									</button>

								}

							</td>

						</tr>

					}

				</tbody>

			</table>

		}

	</div>

	@if (_showDeleteDialog)
	{
		<div class="dialog-overlay">

			<div class="delete-dialog">

				<div class="delete-icon">
					<i class="bi bi-trash-fill"></i>
				</div>

				<h4>Delete Category?</h4>

				<p>
					Are you sure you want to delete this category?
				</p>

				<div class="delete-summary">

					<strong>
						@_categoryToDelete?.Name
					</strong>

					<span class="metal-badge @(_categoryToDelete?.Metal == 1 ? "gold" : "silver")">
						@(_categoryToDelete?.Metal == 1 ? "Gold" : "Silver")
					</span>

				</div>

				@if (!string.IsNullOrWhiteSpace(_deleteDialogError))
				{
					<div class="alert alert-danger mt-3">
						<i class="bi bi-exclamation-triangle-fill me-2"></i>
						@_deleteDialogError
					</div>
				}

				<div class="dialog-buttons">

					<button class="btn-cancel"
					        @onclick="CancelDelete">
						Cancel
					</button>

					<button class="btn-delete-confirm"
					        @onclick="ConfirmDelete">
						<i class="bi bi-trash-fill me-2"></i>
						Delete
					</button>

				</div>

			</div>

		</div>
	}


</div>

@code {

	private List<ItemCategoryDto> _categories = new();

	private ItemCategoryRequest _model = new()
	{
		Metal = 1
	};

	private bool _loading;

	private bool _saving;

	private bool _rememberSelection;

	private string? _successMessage;

	private string? _errorMessage;

	private bool _showSuccessDialog;

	private string _search = "";

	private CancellationTokenSource? _searchDebounce;

	private CancellationTokenSource? _loadCancellation;

	private int? _selectedMetal;

	private bool _showDeleteDialog;

	private ItemCategoryDto? _categoryToDelete;

	private string? _deleteDialogError;

	private bool _canSave;
	protected override async Task OnInitializedAsync()
	{
		await LoadCategories();
	}

	private async Task LoadCategories(int? metal = null)
	{
		_loadCancellation?.Cancel();

		_loadCancellation = new CancellationTokenSource();

		var token = _loadCancellation.Token;

		_loading = true;

		_errorMessage = null;

		try
		{
			var queryParams = new List<string>();

			if (metal.HasValue)
			{
				queryParams.Add(
				$"metal={metal.Value}");
			}

			if (!string.IsNullOrWhiteSpace(_search))
			{
				queryParams.Add(
				$"name={Uri.EscapeDataString(_search)}");
			}

			var url = "item-categories";

			if (queryParams.Any())
			{
				url += "?" + string.Join("&", queryParams);
			}

			var result =
			await Http.GetFromJsonAsync<List<ItemCategoryDto>>(
			url,
			token);

			if (token.IsCancellationRequested)
			return;

			_categories = result ?? new();

		}
		catch(TaskCanceledException)
		{

		}
		catch
		{
			_errorMessage =
			"Unable to load categories.";
		}
		finally
		{
			if(!token.IsCancellationRequested)
			{
				_loading = false;
			}
		}
	}

	private void OnNameChanged(ChangeEventArgs e)
	{
		_model.Name = e.Value?.ToString() ?? string.Empty;

		_canSave = !string.IsNullOrWhiteSpace(_model.Name.Trim());
	}

	private async Task ChangeFilter(int? metal)
	{
		_selectedMetal = metal;

		await LoadCategories(_selectedMetal);
	}

	private async Task OnSearchChanged(ChangeEventArgs e)
	{
		_search =
		e.Value?.ToString()
		?? string.Empty;

		_searchDebounce?.Cancel();

		_searchDebounce =
		new CancellationTokenSource();

		try
		{
			await Task.Delay(
			300,
			_searchDebounce.Token);

			await LoadCategories(_selectedMetal);

		}
		catch(TaskCanceledException)
		{

		}
	}

	private void SelectGold()
	{
		_model.Metal = 1;
	}

	private void SelectSilver()
	{
		_model.Metal = 2;
	}

	private async Task SaveCategory()
	{
		_errorMessage = null;

		_successMessage = null;

		if(string.IsNullOrWhiteSpace(_model.Name))
		{
			_errorMessage =
			"Category name is required.";

			return;
		}

		_saving = true;

		try
		{
			var response =
			await Http.PostAsJsonAsync(
			"item-categories",
			_model);

			if(response.IsSuccessStatusCode)
			{
				_successMessage =
				"Category created successfully.";

				var selectedMetal =
				_model.Metal;

				_model =
				new ItemCategoryRequest
				{
					Metal = _rememberSelection
					? selectedMetal
					: 1
				};

				_canSave = false;

				await LoadCategories(_selectedMetal);

			}
			else
			{
				var error =
				await response.Content
				.ReadFromJsonAsync<ApiErrorResponse>();

				_errorMessage =
				error?.Message
				?? "Unable to create category.";
			}

		}
		catch
		{
			_errorMessage =
			"Unable to save category.";
		}
		finally
		{
			_saving = false;
		}
	}

	private void Edit(ItemCategoryDto category)
	{
		foreach (var item in _categories)
		{
			item.IsEditing = false;
		}

		category.IsEditing = true;

		category.EditName = category.Name
			.Replace("G-", "", StringComparison.OrdinalIgnoreCase)
			.Replace("S-", "", StringComparison.OrdinalIgnoreCase)
			.Trim();
	}

	private void CancelEdit(ItemCategoryDto category)
	{
		category.IsEditing = false;

		category.EditName =
		category.Name;
	}

	private async Task Update(ItemCategoryDto category)
	{
		if(string.IsNullOrWhiteSpace(category.EditName))
		return;

		try
		{
			var request =
			new ItemCategoryRequest
			{
				Name = category.EditName,
				Metal = category.Metal
			};

			var response =
			await Http.PutAsJsonAsync(
			$"item-categories/{category.Id}",
			request);

			if(response.IsSuccessStatusCode)
			{
				_successMessage =
				"Category updated successfully.";

				await LoadCategories(_selectedMetal);
			}
			else
			{
				var error =
				await response.Content
				.ReadFromJsonAsync<ApiErrorResponse>();

				_errorMessage =
				error?.Message
				?? "Unable to create category.";
			}

		}
		catch
		{
			_errorMessage =
			"Unable to update category.";
		}
	}

	private void Delete(ItemCategoryDto category)
	{
		_deleteDialogError = null;

		_categoryToDelete = category;

		_showDeleteDialog = true;
	}

	private async Task ConfirmDelete()
	{
		if(_categoryToDelete == null)
		return;

		try
		{
			var response =
			await Http.DeleteAsync(
			$"item-categories/{_categoryToDelete.Id}");

			if(response.IsSuccessStatusCode)
			{
				_successMessage =
				"Category deleted successfully.";

				_showDeleteDialog = false;

				_categoryToDelete = null;

				await LoadCategories(_selectedMetal);

			}
			else
			{

				var apiError =
					await response.Content.ReadFromJsonAsync<ApiErrorResponse>();

				_deleteDialogError = apiError?.Message;

			}

		}
		catch
		{
			_deleteDialogError =
			"Unable to connect to server.";
		}
	}

	private void CancelDelete()
	{
		_showDeleteDialog = false;

		_categoryToDelete = null;

		_deleteDialogError = null;
	}

	public class ItemCategoryDto
	{
		public int Id { get; set; }

		public string Name { get; set; }
		= string.Empty;

		public int Metal { get; set; }

		// UI only

		public bool IsEditing { get; set; }

		public string EditName { get; set; }
		= string.Empty;
	}

	public class ItemCategoryRequest
	{
		public string Name { get; set; }
		= string.Empty;

		public int Metal { get; set; }
	}

	public class ApiErrorResponse
	{
		public string? Message { get; set; }
	}

}